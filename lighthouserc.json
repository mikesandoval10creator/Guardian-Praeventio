{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/"],
      "startServerCommand": "npm run preview -- --port 4173",
      "startServerReadyPattern": "Local:.*:4173",
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 400,
          "cpuSlowdownMultiplier": 4,
          "uploadThroughputKbps": 400,
          "requestLatencyMs": 150
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new"
      },
      "numberOfRuns": 3
    },
    "assert": {
      "_comment_sprint34": "Sprint 34 audit quick-win: promoted accessibility + best-practices to 'error' (least flake-prone categories — deterministic given fixed DOM/headers). Performance, SEO, PWA stay 'warn' until 2 stable runs in CI confirm no flake.",
      "_comment_oleada1": "Oleada 1 — promote CLS to error (deterministic, layout-only, no runner-load sensitivity). Keep LCP/FCP/TBT/SI/TTI as warn — they remain sensitive to shared runner load and we want to establish a 5-PR baseline before promoting. The 3G throttling preset simulates faena minera bandwidth (Slow 3G, 400 kbps, 150ms RTT, 4x CPU slowdown).",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "categories:pwa": ["warn", { "minScore": 0.7 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "speed-index": ["warn", { "maxNumericValue": 5800 }],
        "interactive": ["warn", { "maxNumericValue": 5500 }],
        "unused-javascript": ["warn", { "maxNumericValue": 81920 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1572864 }],
        "render-blocking-resources": ["warn", { "maxNumericValue": 500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
