<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: MIT
  @praeventio/capacitor-mesh — Android manifest for the BLE GATT implementation.

  BLE permissions below are used by MeshPlugin.kt. Wi-Fi Direct and a
  dedicated foreground service are not implemented; their declarations are
  reserved and do not assert those features are available.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth LE — Android 12+ runtime permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Legacy BLE permissions for SDK <= 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Required for BLE scanning on SDK <= 30 (companion-device flow). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Reserved for the planned Wi-Fi Direct fallback; no transport exists yet. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Reserved permission; this package currently registers no foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
</manifest>
