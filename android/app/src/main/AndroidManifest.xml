<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Sprint 21 — ADR-0013 deep linking).
                 Requires /.well-known/assetlinks.json served by server.ts.
                 Domain must match deploy.yml APP_URL (app.praeventio.net) —
                 see docs/deep-linking-runbook.md for keystore fingerprint setup. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="app.praeventio.net" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Sprint mobile FGS — @capawesome-team/capacitor-android-foreground-service.
             Declares the native foreground service used by the lone-worker
             check-in flow + health/location sustained tracking. The two
             `foregroundServiceType` flags must match the permission set
             declared above (`FOREGROUND_SERVICE_LOCATION` +
             `FOREGROUND_SERVICE_HEALTH`). See:
             https://developer.android.com/develop/background-work/services/fgs/service-types
        -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="location|health"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sprint mobile FGS — required permissions for the
         @capawesome-team/capacitor-android-foreground-service plugin used by
         the lone-worker check-in foreground service.

         FOREGROUND_SERVICE                — base permission (SDK 28+).
         FOREGROUND_SERVICE_LOCATION       — required when foregroundServiceType
                                             includes "location" (SDK 34+).
         FOREGROUND_SERVICE_HEALTH         — required when foregroundServiceType
                                             includes "health" (SDK 34+).
         ACCESS_BACKGROUND_LOCATION        — needed so the worker location
                                             keeps updating when the app is
                                             not in the foreground.
         POST_NOTIFICATIONS                — needed on SDK 33+ to show the
                                             persistent FGS notification.
         WAKE_LOCK                         — keeps the service alive while
                                             check-in interval ticks.

         HIGH_SAMPLING_RATE_SENSORS        — required by Android 12+ for any
                                             foreground service of type 'health'
                                             that registers a sensor listener at
                                             SENSOR_DELAY_GAME / SENSOR_DELAY_FASTEST
                                             (S1, Android Developers, "Salud"). The
                                             native mandown plugin already declares
                                             it in its own manifest; declaring it
                                             here too is defense-in-depth so the
                                             app-level <service> with
                                             foregroundServiceType="location|health"
                                             keeps the contract regardless of how
                                             the plugin manifests are merged.
         BODY_SENSORS_BACKGROUND           — API 33–35 only. Required when the
                                             'health' FGS reads body sensors
                                             (accelerometer, heart rate) while
                                             the app is in the background. The
                                             native ManDown FGS runs
                                             SENSOR_DELAY_GAME on TYPE_ACCELEROMETER
                                             after startForeground, so this gate
                                             applies in practice. Capped at
                                             maxSdkVersion=35 because API 36
                                             deprecates it in favour of
                                             READ_HEALTH_DATA_IN_BACKGROUND.
         READ_HEALTH_DATA_IN_BACKGROUND    — API 36+ replacement for
                                             BODY_SENSORS_BACKGROUND. The
                                             exclusive lower bound (minSdkVersion=36)
                                             is enforced by the SDK; the gate's
                                             tools:targetApi=36 keeps AGP / lint
                                             quiet on older API levels.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — Xiaomi/Huawei/Samsung aggressive
                                             battery savers can terminate a
                                             foreground service within minutes
                                             of the screen turning off unless the
                                             app is on the OS exemption list.
                                             Without this permission + the
                                             runtime prompt handled by
                                             src/services/mobile/batteryOptimization.ts,
                                             the lone-worker check-in loop dies
                                             silently after the worker pockets
                                             their phone. Play Console accepts
                                             this permission for genuine life-
                                             safety apps; the only restriction
                                             is that we must NOT silently grant
                                             it ourselves — the user must
                                             consent through the Settings intent.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.READ_HEALTH_DATA_IN_BACKGROUND"
        tools:targetApi="36"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- USE_FULL_SCREEN_INTENT — Android 14+ (API 34+) requires this permission
         for apps that fire a full-screen intent from a notification so the
         device wakes when an emergency push arrives even if the lock-screen
         is active. Play Console reserves this permission for genuine
         calling/alarm/emergency apps; Guardian qualifies because the package
         ships SOS, manDown, evacuation, and gas-alert foreground flows.
         The TS adapter calls Notification.setFullScreenIntent(pendingIntent, true)
         on the dedicated praeventio_emergency channel (IMPORTANCE_HIGH) so
         a 911-grade alarm surfaces even when the screen is off. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- AUDIT-2026-06 B21 — runtime permissions no plugin manifest provides.

         ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION — required by
             @capacitor/geolocation (its plugin manifest deliberately does
             NOT declare them). Without FINE, ACCESS_BACKGROUND_LOCATION
             above is inert and the SOS / lone-worker GPS fix never
             resolves on device.
         CAMERA — the QR scanner (html5-qrcode) and the on-device
             biometric/pose flows run inside the WebView via getUserMedia;
             Android only surfaces the WebView permission prompt when the
             app itself holds CAMERA.
         RECORD_AUDIO + MODIFY_AUDIO_SETTINGS — same class of bug as CAMERA,
             for the microphone. Capacitor's BridgeWebChromeClient
             (onPermissionRequest) maps the WebView's AUDIO_CAPTURE request
             to BOTH permissions and calls request.deny() unless EVERY
             permission in the array is granted — and Android denies any
             permission the manifest does not declare. Declaring only one of
             the two leaves the mic just as dead. Needed by:
             NoiseMonitor (decibel measurement, DS 594 hygiene),
             CrisisChat (emergency voice message — life-safety path),
             GuardianVoiceAssistant (voice input).

         BLE permissions (BLUETOOTH_SCAN/CONNECT/ADVERTISE + legacy) are
         intentionally NOT declared here — they merge in from the
         @praeventio/capacitor-mesh plugin manifest now that the package
         is included in capacitor.settings.gradle. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Sprint 50 E.10 P1 H6 — Health Connect integration (Ticket
         39baa66d-73fe-81d8-a477-cb1f50948819). The TS adapter is real
         (src/services/health/healthConnectAdapter.ts uses
         @kiwi-health/capacitor-health-connect@^0.0.40) but the Android
         binary lacked the manifest declarations + permission contract.
         READ_* permissions match the record types consumed by the
         adapter (HeartRate, Steps, Calories, SleepSession). -->

    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Health Connect (Android 14+) needs explicit <queries> so the
         package visibility model lets us resolve the HealthConnect provider.
         Without this, `isAvailable()` returns 'notInstalled' even on a
         device that has the Health Connect app installed. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
