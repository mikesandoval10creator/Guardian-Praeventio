# Signing is consumed by app/build.gradle from environment or keystore.properties.
# Never put passwords in Gradle argv (Fastlane/Gradle logs can expose them).
default_platform(:android)
ANDROID_PROJECT = File.expand_path('../android', __dir__)

def build_android_candidate
  gradle(task: 'clean', project_dir: ANDROID_PROJECT, print_command: false)
  gradle(task: 'bundle', build_type: 'Release', project_dir: ANDROID_PROJECT, print_command: false)
end

def distribute_android_candidate(track)
  candidate = ENV['ANDROID_AAB_PATH'] || lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
  candidate = File.expand_path(candidate, File.expand_path('..', __dir__)) if candidate
  UI.user_error!('Signed candidate AAB is required') unless candidate && File.file?(candidate)
  UI.user_error!('Production requires approved workflow candidate') if track == 'production' && ENV['ANDROID_PRODUCTION_APPROVED'] != 'true'
  upload_to_play_store(track: track, aab: candidate, skip_upload_metadata: true,
                       skip_upload_images: true, skip_upload_screenshots: true)
end

platform :android do
  desc 'Build signed AAB, without distribution'
  lane :build_only do
    build_android_candidate
  end
  desc 'Build signed AAB and upload to Internal Testing'
  lane :internal do
    build_android_candidate
    distribute_android_candidate('internal')
  end
  desc 'Build signed AAB and upload after explicit production approval'
  lane :production do
    UI.user_error!('Production requires explicit approval') unless ENV['ANDROID_PRODUCTION_APPROVED'] == 'true'
    build_android_candidate
    distribute_android_candidate('production')
  end
  desc 'Upload the already-built candidate (protected workflow only)'
  lane :upload_candidate do
    track = ENV.fetch('ANDROID_TRACK', 'internal')
    UI.user_error!('Unsupported Android track') unless ['internal', 'production'].include?(track)
    distribute_android_candidate(track)
  end
end
